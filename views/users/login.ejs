<% layout("/layouts/boilerplate") %>

    <main class="auth-page">
        <section class="auth-card" aria-labelledby="login-heading">
            <div class="auth-heading">
                <p class="auth-eyebrow">Welcome back</p>
                <h1 id="login-heading">Log in to Wanderlust</h1>
                <p>Return to the stays and places waiting for you.</p>
            </div>
            <form action="/login" method="POST" class="needs-validation auth-form" novalidate>
                <div class="auth-field">
                    <label for="username" class="form-label">Username</label>
                    <input name="username" id="username" type="text" class="form-control" autocomplete="username"
                        required />
                </div>
                <div class="auth-field">
                    <label for="password" class="form-label">Password</label>
                    <input name="password" id="password" type="password" class="form-control"
                        autocomplete="current-password" required />
                </div>
                <button class="btn auth-submit" type="submit">Log in</button>
            </form>
            <p class="auth-switch">New to Wanderlust? <a href="/signup">Create an account</a></p>
        </section>
    </main>