<% layout("layouts/boilerplate") %>

    <style>
        body {
            background-color: #F8F9FA;
            color: #333;
        }

        /* Layout Wrapper */
        .dashboard-wrapper {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 2rem;
            max-width: 95%;
            margin: 2rem auto;
            min-height: 85vh;
        }

        /* Sidebar Styles (Consistent with Index) */
        .sidebar {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            height: fit-content;
            position: sticky;
            top: 100px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            border: 1px solid rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .user-mini-profile {
            text-align: center;
            padding-bottom: 2rem;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .sidebar-avatar {
            width: 80px;
            height: 80px;
            margin: 0 auto 1rem;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--luxury-gold), #E8D5A3);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-serif);
            font-weight: 600;
            font-size: 2rem;
            box-shadow: 0 10px 20px rgba(201, 162, 39, 0.2);
        }

        .sidebar-name {
            font-family: var(--font-serif);
            font-size: 1.25rem;
            font-weight: 600;
            color: #222;
        }

        .sidebar-role {
            font-family: var(--font-sans);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--luxury-gold);
            font-weight: 700;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            text-decoration: none;
            color: #666;
            font-family: var(--font-sans);
            font-weight: 500;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .nav-item:hover {
            background: rgba(201, 162, 39, 0.05);
            color: var(--luxury-gold);
            transform: translateX(5px);
        }

        .nav-item.active {
            background: var(--luxury-gold);
            color: white;
            box-shadow: 0 4px 15px rgba(201, 162, 39, 0.2);
        }

        .nav-item i { width: 20px; text-align: center; }

        /* Profile Specific Grid */
        .profile-content-grid {
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 2rem;
            align-items: start;
        }

        .card {
            background: white;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 4px 25px rgba(0,0,0,0.03);
            border: 1px solid rgba(0,0,0,0.03);
            position: relative;
            overflow: hidden;
        }

        /* Left Column: Identity Card */
        .identity-card {
            text-align: center;
        }
        
        .identity-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 120px;
            background: linear-gradient(135deg, rgba(201, 162, 39, 0.1), rgba(232, 213, 163, 0.2));
            z-index: 0;
        }

        .large-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: white;
            color: var(--luxury-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-serif);
            font-size: 3.5rem;
            margin: 2rem auto 1.5rem;
            position: relative;
            z-index: 1;
            border: 4px solid white;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .user-title h2 {
            font-family: var(--font-serif);
            font-size: 1.75rem;
            margin: 0;
            color: #222;
        }

        .user-title p {
            color: #888;
            font-family: var(--font-sans);
            margin-top: 0.5rem;
        }

        .stats-row {
            display: flex;
            justify-content: space-around;
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(0,0,0,0.05);
        }

        .stat-item {
            text-align: center;
        }

        .stat-val {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--luxury-gold);
            line-height: 1;
        }

        .stat-lbl {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #999;
            margin-top: 0.5rem;
        }

        /* Right Column: Edit Form */
        .edit-card h3 {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .edit-card h3::after {
            content: '';
            flex-grow: 1;
            height: 1px;
            background: rgba(0,0,0,0.05);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
        
        .full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.75rem;
            font-family: var(--font-sans);
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #555;
        }

        .form-control {
            width: 100%;
            padding: 0.85rem 1.25rem;
            background: #FAFAFA;
            border: 1px solid #eee;
            border-radius: 8px;
            font-size: 1rem;
            color: #333;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background: white;
            border-color: var(--luxury-gold);
            box-shadow: 0 0 0 4px rgba(201, 162, 39, 0.05);
            outline: none;
        }
        
        .form-control:disabled {
            background: #f5f5f5;
            color: #aaa;
            cursor: not-allowed;
        }

        .btn-save {
            background: var(--luxury-gold);
            color: white;
            border: none;
            padding: 1rem 2rem;
            border-radius: 50px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-top: 2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(201, 162, 39, 0.2);
        }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(201, 162, 39, 0.3);
            background: #D4B040;
        }

        @media (max-width: 1100px) {
            .dashboard-wrapper { grid-template-columns: 80px 1fr; }
            .sidebar-name, .sidebar-role, .sidebar-nav span, .user-mini-profile { display: none; }
            .sidebar { padding: 1rem; align-items: center; }
            .nav-item { justify-content: center; }
            .sidebar-avatar { width: 50px; height: 50px; font-size: 1.5rem; margin: 0; }
            .profile-content-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 768px) {
            .sidebar { display: none; }
            .dashboard-wrapper { grid-template-columns: 1fr; margin: 1rem; }
            .form-grid { grid-template-columns: 1fr; }
        }
    </style>

    <div class="dashboard-wrapper">
        
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="user-mini-profile">
                <div class="sidebar-avatar">
                   <%= user.username.charAt(0).toUpperCase() %>
                </div>
                <div class="sidebar-name"><%= user.username %></div>
                <div class="sidebar-role"><%= user.role %> Account</div>
            </div>

            <nav class="sidebar-nav">
                <a href="/dashboard" class="nav-item">
                    <i class="fas fa-th-large"></i> <span>Overview</span>
                </a>
                <a href="/dashboard/profile" class="nav-item active">
                    <i class="fas fa-user-circle"></i> <span>My Profile</span>
                </a>
                <a href="/dashboard/listings" class="nav-item">
                    <i class="fas fa-building"></i> <span>My Stays</span>
                </a>
                <a href="/dashboard/vehicles" class="nav-item">
                    <i class="fas fa-car"></i> <span>My Vehicles</span>
                </a>
                <a href="/dashboard/dhabas" class="nav-item">
                    <i class="fas fa-utensils"></i> <span>Dining</span>
                </a>
                <a href="/dashboard/bookings" class="nav-item">
                    <i class="fas fa-calendar-alt"></i> <span>Bookings</span>
                </a>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            
            <div class="content-header" style="margin-bottom: 2rem; background: transparent; box-shadow: none; padding: 0;">
                <div class="welcome-text">
                    <h1>Profile Settings</h1>
                    <p>Manage your personal information and account security.</p>
                </div>
            </div>

            <div class="profile-content-grid">
                
                <!-- Left Column: Identity Card -->
                <div class="card identity-card">
                    <div class="large-avatar">
                        <%= user.username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="user-title">
                        <h2><%= user.username %></h2>
                        <p><%= user.email %></p>
                        <span class="badge rounded-pill bg-light text-dark mt-2" style="border: 1px solid #ddd; padding: 0.5em 1em;">
                            <%= user.role.toUpperCase() %>
                        </span>
                    </div>

                    <div class="stats-row">
                        <div class="stat-item">
                            <div class="stat-val">
                                <%= user.createdAt ? new Date().getFullYear() - new Date(user.createdAt).getFullYear() : 0 %>
                            </div>
                            <div class="stat-lbl">Years</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-val">5.0</div> <!-- Placeholder rating -->
                            <div class="stat-lbl">Rating</div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Edit Form -->
                <div class="card edit-card">
                    <h3>Personal Details</h3>
                    
                    <form action="/dashboard/profile?_method=PUT" method="POST">
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="username">Username</label>
                                <input type="text" class="form-control" value="<%= user.username %>" disabled>
                            </div>

                            <div class="form-group">
                                <label for="role">Account Type</label>
                                <input type="text" class="form-control" value="<%= user.role %>" disabled style="text-transform: capitalize;">
                            </div>

                            <div class="form-group full-width">
                                <label for="email">Email Address</label>
                                <input type="email" name="email" id="email" class="form-control" value="<%= user.email %>" required>
                            </div>

                            <div class="form-group full-width">
                                <label for="contact">Contact Number</label>
                                <input type="text" id="contact" class="form-control" value="+91 XXXXX XXXXX" disabled>
                                <small style="color: #999; margin-top: 5px; display: block;">Contact details are managed by admin.</small>
                            </div>
                        </div>

                        <div style="text-align: right;">
                            <button type="submit" class="btn-save">Save Changes</button>
                        </div>
                    </form>
                </div>

            </div>
        </main>
    </div>