<% layout("layouts/boilerplate") %>

    <style>
        body {
            background-color: #F8F9FA;
            color: #333;
        }

        /* Full Width Layout Wrapper */
        .dashboard-wrapper {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 2rem;
            max-width: 98%;
            margin: 2rem auto;
            min-height: 85vh;
        }

        /* ========================
           SIDEBAR STYLES
           ======================== */
        .sidebar {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            height: fit-content;
            position: sticky;
            top: 100px; /* Below navbar */
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            border: 1px solid rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .user-mini-profile {
            text-align: center;
            padding-bottom: 2rem;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .sidebar-avatar {
            width: 80px;
            height: 80px;
            margin: 0 auto 1rem;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--luxury-gold), #E8D5A3);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-serif);
            font-weight: 600;
            font-size: 2rem;
            box-shadow: 0 10px 20px rgba(201, 162, 39, 0.2);
        }

        .sidebar-name {
            font-family: var(--font-serif);
            font-size: 1.25rem;
            font-weight: 600;
            color: #222;
            margin-bottom: 0.25rem;
        }

        .sidebar-role {
            font-family: var(--font-sans);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--luxury-gold);
            font-weight: 700;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            text-decoration: none;
            color: #666;
            font-family: var(--font-sans);
            font-weight: 500;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .nav-item:hover {
            background: rgba(201, 162, 39, 0.05);
            color: var(--luxury-gold);
            transform: translateX(5px);
        }

        .nav-item.active {
            background: var(--luxury-gold);
            color: white;
            box-shadow: 0 4px 15px rgba(201, 162, 39, 0.2);
        }

        .nav-item i {
            width: 20px;
            text-align: center;
        }
        
        .admin-section {
            padding-top: 1rem;
            border-top: 1px solid rgba(0,0,0,0.05);
        }
        
        .nav-item.admin-link {
            border: 1px dashed rgba(201, 162, 39, 0.3);
            color: var(--luxury-gold);
        }
        
        .nav-item.admin-link:hover {
            background: var(--luxury-gold);
            color: white;
            border-style: solid;
        }

        /* ========================
           MAIN CONTENT STYLES
           ======================== */
        .main-content {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        /* Header Area */
        .content-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: white;
            padding: 2rem;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }

        .welcome-text h1 {
            font-family: var(--font-serif);
            font-size: 2rem;
            margin: 0;
            color: #222;
        }

        .welcome-text p {
            color: #888;
            margin: 0.5rem 0 0;
            font-family: var(--font-sans);
        }

        .quick-actions-row {
            display: flex;
            gap: 1rem;
        }

        .btn-quick {
            padding: 0.75rem 1.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-family: var(--font-sans);
            font-weight: 600;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-add {
            background: #222;
            color: white;
        }
        
        .btn-add:hover {
            background: var(--luxury-gold);
            transform: translateY(-2px);
        }
        
        .btn-outline {
            border: 1px solid #e0e0e0;
            color: #555;
        }
        
        .btn-outline:hover {
            border-color: #333;
            color: #222;
        }

        /* Stats Grid - 4 Columns */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
        }

        .stat-card {
            background: white;
            padding: 1.5rem 2rem;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            display: flex;
            align-items: center;
            gap: 1.5rem;
            transition: transform 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .stat-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--luxury-gold);
            opacity: 0.5;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: rgba(201, 162, 39, 0.1);
            color: var(--luxury-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .stat-info .count {
            font-family: var(--font-serif);
            font-size: 2rem;
            font-weight: 600;
            line-height: 1;
            color: #222;
        }

        .stat-info .label {
            font-family: var(--font-sans);
            font-size: 0.85rem;
            color: #888;
            margin-top: 5px;
        }

        /* Dashboard Split Layout (2 Columns) */
        .dashboard-split {
            display: grid;
            grid-template-columns: 1fr 1fr; /* 50% 50% Split */
            gap: 2rem;
        }

        .split-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            height: 100%;
        }

        .split-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 1rem;
        }

        .split-header h2 {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        .split-header h2 i {
            color: var(--luxury-gold);
            font-size: 1.2rem;
        }

        .view-all {
            color: var(--luxury-gold);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* List Items */
        .list-items {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .list-item {
            display: flex;
            gap: 1.5rem;
            padding: 1rem;
            border-radius: 12px;
            background: #FAFAFA;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .list-item:hover {
            background: white;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            border-color: rgba(201, 162, 39, 0.2);
            transform: scale(1.02);
        }

        .item-img {
            width: 100px;
            height: 70px;
            border-radius: 8px;
            object-fit: cover;
        }

        .item-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .item-title {
            font-family: var(--font-serif);
            font-weight: 600;
            font-size: 1.1rem;
            margin: 0 0 0.25rem 0;
            color: #222;
        }

        .item-subtitle {
            font-size: 0.85rem;
            color: #777;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .item-pill {
            margin-left: auto;
            align-self: flex-start;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
        }
        
        .pill-price {
            background: #222;
            color: var(--luxury-gold);
        }
        
        .pill-status {
            text-transform: capitalize;
        }
        
        .status-confirmed, .status-active { background: #E8F5E9; color: #2E7D32; }
        .status-pending { background: #FFF3E0; color: #E65100; }
        .status-cancelled { background: #FFEBEE; color: #C62828; }

        /* Empty State */
        .empty-placeholder {
            text-align: center;
            padding: 3rem;
            color: #999;
        }
        
        .empty-placeholder i {
            display: block;
            font-size: 2.5rem;
            margin-bottom: 1rem;
            opacity: 0.3;
        }

        /* Responsive */
        @media (max-width: 1100px) {
            .dashboard-wrapper {
                grid-template-columns: 80px 1fr; /* Collapsed sidebar */
            }
            .sidebar {
                padding: 1rem;
                align-items: center;
            }
            .sidebar-name, .sidebar-role, .nav-text, .user-mini-profile {
                display: none;
            }
            .nav-item {
                justify-content: center;
                padding: 1rem;
            }
            .sidebar-avatar {
                width: 50px;
                height: 50px;
                font-size: 1.5rem;
                margin-bottom: 0;
            }
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .dashboard-wrapper {
                grid-template-columns: 1fr;
                margin: 1rem;
            }
            .sidebar {
                display: none; /* Hide sidebar on mobile, maybe show hamburger */
            }
            .dashboard-split {
                grid-template-columns: 1fr;
            }
            .stats-grid {
                grid-template-columns: 1fr;
            }
            .content-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1.5rem;
            }
            .quick-actions-row {
                width: 100%;
                justify-content: space-between;
            }
        }
    </style>

    <div class="dashboard-wrapper">
        
        <!-- SIDEBAR NAVIGATION -->
        <aside class="sidebar">
            <div class="user-mini-profile">
                <div class="sidebar-avatar">
                   <%= currUser.username.charAt(0).toUpperCase() %>
                </div>
                <div class="sidebar-name"><%= currUser.username %></div>
                <div class="sidebar-role"><%= currUser.role %> Account</div>
            </div>

            <nav class="sidebar-nav">
                <a href="/dashboard" class="nav-item active">
                    <i class="fas fa-th-large"></i> <span class="nav-text">Overview</span>
                </a>
                <a href="/dashboard/profile" class="nav-item">
                    <i class="fas fa-user-circle"></i> <span class="nav-text">My Profile</span>
                </a>
                <a href="/dashboard/listings" class="nav-item">
                    <i class="fas fa-building"></i> <span class="nav-text">My Stays</span>
                </a>
                <a href="/dashboard/vehicles" class="nav-item">
                    <i class="fas fa-car"></i> <span class="nav-text">My Vehicles</span>
                </a>
                <a href="/dashboard/dhabas" class="nav-item">
                    <i class="fas fa-utensils"></i> <span class="nav-text">Dining</span>
                </a>
                <a href="/dashboard/bookings" class="nav-item">
                    <i class="fas fa-calendar-alt"></i> <span class="nav-text">Bookings</span>
                </a>

                <% if (currUser.role === 'admin') { %>
                    <div class="admin-section">
                        <a href="/admin" class="nav-item admin-link">
                            <i class="fas fa-shield-alt"></i> <span class="nav-text">Admin Panel</span>
                        </a>
                    </div>
                <% } %>
            </nav>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <main class="main-content">
            
            <!-- 1. Header & Quick Actions -->
            <div class="content-header">
                <div class="welcome-text">
                    <h1>Dashboard</h1>
                    <p>Manage your properties and bookings from one place.</p>
                </div>
                <div class="quick-actions-row">
                    <a href="/listings/new" class="btn-quick btn-add">
                        <i class="fas fa-plus"></i> Add Listing
                    </a>
                </div>
            </div>

            <!-- 2. Statistics Grid (Wide) -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-home"></i></div>
                    <div class="stat-info">
                        <div class="count"><%= myListings.length %></div>
                        <div class="label">Total Stays</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-car-side"></i></div>
                    <div class="stat-info">
                        <div class="count"><%= myVehicles.length %></div>
                        <div class="label">Vehicles</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-utensils"></i></div>
                    <div class="stat-info">
                        <div class="count"><%= myDhabas.length %></div>
                        <div class="label">Dining Spots</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                    <div class="stat-info">
                        <div class="count"><%= myBookings.length %></div>
                        <div class="label">Bookings</div>
                    </div>
                </div>
            </div>

            <!-- 3. Split View Content -->
            <div class="dashboard-split">
                
                <!-- Recent Listings Column (Left) -->
                <div class="split-card">
                    <div class="split-header">
                        <h2><i class="fas fa-building"></i> Recent Stays</h2>
                        <a href="/dashboard/listings" class="view-all">View All</a>
                    </div>
                    
                    <% if (myListings.length > 0) { %>
                        <div class="list-items">
                            <% myListings.slice(0, 4).forEach(listing => { %>
                                <a href="/listings/<%= listing._id %>" class="list-item">
                                    <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=200' %>" 
                                         alt="<%= listing.title %>" class="item-img">
                                    <div class="item-content">
                                        <h4 class="item-title"><%= listing.title %></h4>
                                        <div class="item-subtitle">
                                            <i class="fas fa-map-marker-alt"></i> <%= listing.location %>
                                        </div>
                                    </div>
                                    <div class="item-pill pill-price">₹<%= listing.price.toLocaleString('en-IN') %></div>
                                </a>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-placeholder">
                            <i class="fas fa-folder-open"></i>
                            <p>No listings created yet</p>
                            <a href="/listings/new" class="btn-quick btn-outline" style="display:inline-flex; border-radius:30px;">Create First</a>
                        </div>
                    <% } %>
                </div>

                <!-- Recent Bookings Column (Right) -->
                <div class="split-card">
                    <div class="split-header">
                        <h2><i class="fas fa-calendar"></i> Recent Activity</h2>
                        <a href="/dashboard/bookings" class="view-all">View All</a>
                    </div>

                    <% if (myBookings.length > 0) { %>
                        <div class="list-items">
                            <% myBookings.slice(0, 4).forEach(booking => { 
                                let imgUrl = 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=200';
                                let title = 'Booking';
                                
                                if (booking.listing) {
                                    imgUrl = booking.listing.image && booking.listing.image.url ? booking.listing.image.url : imgUrl;
                                    title = booking.listing.title;
                                } else if (booking.vehicle) title = booking.vehicle.title;
                                else if (booking.dhaba) title = booking.dhaba.title;
                            %>
                                <div class="list-item">
                                    <img src="<%= imgUrl %>" alt="<%= title %>" class="item-img">
                                    <div class="item-content">
                                        <h4 class="item-title"><%= title %></h4>
                                        <div class="item-subtitle">
                                            <%= booking.checkIn ? new Date(booking.checkIn).toLocaleDateString() : 'N/A' %>
                                        </div>
                                    </div>
                                    <div class="item-pill pill-status status-<%= booking.status || 'pending' %>">
                                        <%= booking.status || 'pending' %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-placeholder">
                            <i class="fas fa-calendar-times"></i>
                            <p>No bookings yet</p>
                        </div>
                    <% } %>
                </div>

            </div> <!-- End Split -->
        </main>
    </div>