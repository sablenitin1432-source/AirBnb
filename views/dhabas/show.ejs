<% layout("layouts/boilerplate")%>

<style>
    /* ===================================
       FOUR SEASONS LUXURY DINING PAGE
       =================================== */
    
    :root {
        --fs-gold: #C9A227;
        --fs-gold-light: #E8D5A3;
        --fs-dark: #1A1A1A;
        --fs-dark-soft: #2A2A2A;
        --fs-cream: #FAF8F5;
        --fs-text: #333;
        --fs-text-light: #717171;
        --fs-border: #E8E8E8;
        --fs-serif: 'Playfair Display', Georgia, serif;
        --fs-sans: 'Plus Jakarta Sans', 'Helvetica Neue', sans-serif;
        --fs-elegant: 'Cormorant Garamond', Georgia, serif;
    }

    .dining-detail-page {
        margin-top: -1rem;
    }

    /* ===================================
       HERO IMAGE GALLERY
       =================================== */
    
    .detail-hero {
        position: relative;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        height: 85vh;
        min-height: 550px;
        max-height: 850px;
        overflow: hidden;
        background: var(--fs-dark);
    }

    .detail-hero img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
        animation: heroFadeIn 0.6s ease;
    }

    .detail-hero img.active {
        display: block;
    }

    @keyframes heroFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .detail-hero__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(0,0,0,0.3) 0%,
            rgba(0,0,0,0.05) 40%,
            rgba(0,0,0,0.05) 60%,
            rgba(0,0,0,0.6) 100%
        );
        z-index: 1;
    }

    .detail-hero__content {
        position: absolute;
        bottom: 3rem;
        left: 0;
        right: 0;
        z-index: 2;
        text-align: center;
        padding: 0 2rem;
    }

    .detail-hero__eyebrow {
        font-family: var(--fs-elegant);
        font-size: 1rem;
        font-style: italic;
        color: var(--fs-gold-light);
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
    }

    .detail-hero__title {
        font-family: var(--fs-serif);
        font-size: clamp(1.75rem, 4vw, 3rem);
        font-weight: 400;
        color: white;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
    }

    .detail-hero__location {
        font-family: var(--fs-sans);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.8);
    }

    /* Gallery Navigation */
    .hero-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.25);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
        z-index: 3;
    }

    .hero-nav:hover {
        background: rgba(255,255,255,0.3);
        transform: translateY(-50%) scale(1.05);
    }

    .hero-prev { left: 2rem; }
    .hero-next { right: 2rem; }

    .hero-dots {
        position: absolute;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
        z-index: 3;
    }

    .hero-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,0.4);
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0;
    }

    .hero-dot.active {
        background: var(--fs-gold);
        transform: scale(1.4);
    }

    .hero-counter {
        position: absolute;
        top: 1.5rem;
        right: 2rem;
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(8px);
        color: white;
        padding: 0.4rem 1rem;
        font-family: var(--fs-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        z-index: 3;
    }

    .hero-back {
        position: absolute;
        top: 1.5rem;
        left: 2rem;
        z-index: 3;
        color: white;
        text-decoration: none;
        font-family: var(--fs-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: rgba(0,0,0,0.4);
        backdrop-filter: blur(8px);
        transition: all 0.3s ease;
    }

    .hero-back:hover {
        background: rgba(0,0,0,0.7);
        color: var(--fs-gold-light);
    }

    .hero-view-all {
        position: absolute;
        bottom: 1.5rem;
        right: 2rem;
        z-index: 3;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        padding: 0.6rem 1.25rem;
        font-family: var(--fs-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .hero-view-all:hover {
        background: rgba(255,255,255,0.3);
    }

    /* ===================================
       CONTENT AREA
       =================================== */
    
    .detail-content {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* ===================================
       DINING INTRO SECTION
       =================================== */
    
    .dining-intro {
        text-align: center;
        padding: 4rem 0 3rem;
        border-bottom: 1px solid var(--fs-border);
    }

    .dining-intro__type {
        font-family: var(--fs-elegant);
        font-size: 1rem;
        font-style: italic;
        color: var(--fs-gold);
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .dining-intro__title {
        font-family: var(--fs-serif);
        font-size: clamp(1.75rem, 3.5vw, 2.75rem);
        font-weight: 400;
        color: var(--fs-dark);
        margin-bottom: 1rem;
        letter-spacing: 0.03em;
    }

    .dining-intro__location {
        font-family: var(--fs-sans);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--fs-text-light);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .dining-intro__location i {
        color: var(--fs-gold);
    }

    /* Dining Specs */
    .dining-specs-bar {
        display: flex;
        justify-content: center;
        gap: 0;
        margin-top: 2.5rem;
    }

    .spec-item {
        text-align: center;
        padding: 0 2.5rem;
        border-right: 1px solid var(--fs-border);
    }

    .spec-item:last-child {
        border-right: none;
    }

    .spec-item__icon {
        font-size: 1.25rem;
        color: var(--fs-gold);
        margin-bottom: 0.5rem;
    }

    .spec-item__label {
        font-family: var(--fs-sans);
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--fs-text-light);
        margin-bottom: 0.25rem;
    }

    .spec-item__value {
        font-family: var(--fs-serif);
        font-size: 1.1rem;
        color: var(--fs-dark);
    }

    /* Cuisine Tags */
    .cuisine-tags {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.75rem;
    }

    .cuisine-tag {
        background: var(--fs-dark);
        color: var(--fs-gold-light);
        padding: 0.4rem 1.25rem;
        font-family: var(--fs-sans);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    /* ===================================
       MAIN GRID (Description + Booking)
       =================================== */
    
    .detail-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 4rem;
        padding: 3rem 0;
    }

    .detail-description {
        padding-right: 2rem;
    }

    .section-label {
        font-family: var(--fs-sans);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--fs-gold);
        margin-bottom: 1rem;
    }

    .detail-description__text {
        font-family: var(--fs-elegant);
        font-size: 1.15rem;
        line-height: 1.8;
        color: var(--fs-text);
    }

    /* Specialties */
    .specialties-section {
        margin-top: 2.5rem;
        padding-top: 2.5rem;
        border-top: 1px solid var(--fs-border);
    }

    .specialties-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .specialty-pill {
        background: var(--fs-cream);
        border: 1px solid var(--fs-border);
        padding: 0.6rem 1.25rem;
        font-family: var(--fs-sans);
        font-size: 0.8rem;
        color: var(--fs-dark);
        font-weight: 500;
    }

    /* Features Section */
    .features-section {
        margin-top: 2.5rem;
        padding-top: 2.5rem;
        border-top: 1px solid var(--fs-border);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1rem;
        border-bottom: 1px solid #f0f0f0;
        font-family: var(--fs-sans);
        font-size: 0.85rem;
        color: var(--fs-text);
    }

    .feature-item i {
        color: var(--fs-gold);
        width: 20px;
        text-align: center;
        font-size: 1rem;
    }

    /* Host Card */
    .host-card {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 2.5rem;
        padding: 1.5rem;
        background: var(--fs-cream);
    }

    .host-avatar {
        width: 56px;
        height: 56px;
        background: var(--fs-dark);
        color: var(--fs-gold-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--fs-serif);
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .host-info__name {
        font-family: var(--fs-serif);
        font-size: 1.1rem;
        color: var(--fs-dark);
        margin-bottom: 0.15rem;
    }

    .host-info__badge {
        font-family: var(--fs-sans);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--fs-gold);
    }

    /* Owner Actions */
    .owner-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .owner-btn {
        flex: 1;
        padding: 0.85rem 1.5rem;
        font-family: var(--fs-sans);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-align: center;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .owner-btn--edit {
        background: var(--fs-dark);
        color: white;
    }

    .owner-btn--edit:hover {
        background: #333;
        color: var(--fs-gold-light);
    }

    .owner-btn--delete {
        background: transparent;
        color: #c0392b;
        border: 1px solid #c0392b;
    }

    .owner-btn--delete:hover {
        background: #c0392b;
        color: white;
    }

    /* ===================================
       RESERVATION CARD
       =================================== */
    
    .booking-card {
        position: sticky;
        top: 100px;
        background: white;
        border: 1px solid var(--fs-border);
        padding: 2.5rem 2rem;
    }

    .booking-card__title {
        font-family: var(--fs-serif);
        font-size: 1.5rem;
        font-weight: 400;
        color: var(--fs-dark);
        margin-bottom: 0.25rem;
    }

    .booking-card__subtitle {
        font-family: var(--fs-sans);
        font-size: 0.8rem;
        color: var(--fs-text-light);
    }

    .booking-card__divider {
        width: 40px;
        height: 2px;
        background: var(--fs-gold);
        margin: 1.25rem 0;
    }

    .booking-card__label {
        font-family: var(--fs-sans);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--fs-text-light);
        display: block;
        margin-bottom: 0.4rem;
    }

    .booking-card__input {
        width: 100%;
        padding: 0.85rem 1rem;
        border: 1px solid var(--fs-border);
        font-family: var(--fs-sans);
        font-size: 0.85rem;
        color: var(--fs-dark);
        background: white;
        transition: border-color 0.3s ease;
        outline: none;
        margin-bottom: 1rem;
    }

    .booking-card__input:focus {
        border-color: var(--fs-gold);
    }

    .booking-card__row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }

    .booking-card__submit {
        width: 100%;
        padding: 1.1rem;
        background: var(--fs-dark);
        color: white;
        border: none;
        font-family: var(--fs-sans);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: 0.5rem;
    }

    .booking-card__submit:hover {
        background: var(--fs-gold);
        color: white;
    }

    .booking-card__login {
        display: block;
        text-align: center;
        text-decoration: none;
        width: 100%;
        padding: 1.1rem;
        background: var(--fs-dark);
        color: white;
        font-family: var(--fs-sans);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

    .booking-card__login:hover {
        background: var(--fs-gold);
        color: white;
    }

    .booking-card__note {
        text-align: center;
        font-family: var(--fs-sans);
        font-size: 0.75rem;
        color: var(--fs-text-light);
        margin-top: 0.75rem;
    }

    /* ===================================
       MAP SECTION
       =================================== */
    
    .map-section {
        padding: 3rem 0;
        border-top: 1px solid var(--fs-border);
    }

    .map-section__title {
        font-family: var(--fs-serif);
        font-size: 1.5rem;
        font-weight: 400;
        color: var(--fs-dark);
        margin-bottom: 0.5rem;
    }

    .map-section__subtitle {
        font-family: var(--fs-sans);
        font-size: 0.85rem;
        color: var(--fs-text-light);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .map-section__subtitle i {
        color: var(--fs-gold);
    }

    #map {
        height: 400px;
        background: #e9e9e9;
    }

    /* ===================================
       LIGHTBOX
       =================================== */

    .lb-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.95);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }
    .lb-overlay.active { display: flex; }
    .lb-close {
        position: absolute; top: 1.5rem; right: 2rem;
        background: none; border: none; color: white; font-size: 2rem; cursor: pointer; z-index: 10001;
    }
    .lb-counter {
        position: absolute; top: 1.5rem; left: 2rem;
        color: rgba(255,255,255,0.7); font-family: var(--fs-sans); font-size: 0.85rem;
        font-weight: 600; letter-spacing: 0.1em; z-index: 10001;
    }
    .lb-img-wrap { max-width: 85vw; max-height: 85vh; }
    .lb-img-wrap img { max-width: 85vw; max-height: 85vh; object-fit: contain; }
    .lb-nav {
        position: absolute; top: 50%; transform: translateY(-50%);
        background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25);
        width: 48px; height: 48px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; color: white; font-size: 1rem;
        transition: all 0.3s ease; z-index: 10001;
    }
    .lb-nav:hover { background: rgba(255,255,255,0.3); }
    .lb-prev { left: 2rem; }
    .lb-next { right: 2rem; }

    /* ===================================
       RESPONSIVE
       =================================== */

    @media (max-width: 768px) {
        .detail-hero { height: 60vh; min-height: 350px; }
        .detail-grid { grid-template-columns: 1fr; gap: 2rem; }
        .detail-description { padding-right: 0; }
        .dining-specs-bar { flex-wrap: wrap; gap: 1rem; }
        .spec-item { border-right: none; padding: 0 1.5rem; }
    }
</style>

<!-- Lightbox Modal -->
<div class="lb-overlay" id="dhabaLightbox">
    <button class="lb-close" onclick="closeLightbox()">&times;</button>
    <span class="lb-counter" id="lbCounter"></span>
    <button class="lb-nav lb-prev" onclick="lbNav(-1)"><i class="fas fa-chevron-left"></i></button>
    <button class="lb-nav lb-next" onclick="lbNav(1)"><i class="fas fa-chevron-right"></i></button>
    <div class="lb-img-wrap">
        <img src="" alt="Gallery image" id="lbImage">
    </div>
</div>

<div class="dining-detail-page">

    <!-- ===================================
         FULL-WIDTH HERO IMAGE GALLERY
         =================================== -->
    <section class="detail-hero" id="heroGallery">
        <%
          let allImages = [];
          if(dhaba.images && dhaba.images.length > 0) {
            allImages = dhaba.images;
          } else if(dhaba.image && dhaba.image.url) {
            allImages = [dhaba.image];
          } else {
            allImages = [{ url: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1200' }];
          }
        %>
        <% allImages.forEach((img, idx) => { %>
            <img src="<%= img.url %>" alt="<%= dhaba.title %> - Photo <%= idx + 1 %>" class="<%= idx === 0 ? 'active' : '' %>">
        <% }); %>

        <div class="detail-hero__overlay"></div>

        <!-- Back Button -->
        <a href="/dhabas" class="hero-back">
            <i class="fas fa-arrow-left"></i> Back to Dining
        </a>

        <!-- Counter -->
        <% if(allImages.length > 1) { %>
            <div class="hero-counter"><span id="slideNum">1</span> / <%= allImages.length %></div>
        <% } %>

        <!-- Title Overlay -->
        <div class="detail-hero__content">
            <p class="detail-hero__eyebrow"><%= dhaba.category || 'Fine Dining' %></p>
            <h1 class="detail-hero__title"><%= dhaba.title %></h1>
            <p class="detail-hero__location">
                <i class="fas fa-map-marker-alt"></i>
                <%= dhaba.location %>
            </p>
        </div>

        <!-- Navigation -->
        <% if(allImages.length > 1) { %>
            <button class="hero-nav hero-prev" onclick="changeSlide(-1)"><i class="fas fa-chevron-left"></i></button>
            <button class="hero-nav hero-next" onclick="changeSlide(1)"><i class="fas fa-chevron-right"></i></button>
            <div class="hero-dots">
                <% allImages.forEach((img, idx) => { %>
                    <button class="hero-dot <%= idx === 0 ? 'active' : '' %>" onclick="goToSlide(<%= idx %>)"></button>
                <% }); %>
            </div>
        <% } %>

        <!-- View All Photos -->
        <% if(allImages.length > 1) { %>
            <button class="hero-view-all" onclick="openLightbox(0)">
                <i class="fas fa-images"></i> View All Photos (<%= allImages.length %>)
            </button>
        <% } %>
    </section>

    <div class="detail-content">

        <!-- ===================================
             DINING INTRO
             =================================== -->
        <div class="dining-intro">
            <p class="dining-intro__type"><%= dhaba.category || 'Dining Experience' %></p>
            <h2 class="dining-intro__title"><%= dhaba.title %></h2>
            <p class="dining-intro__location">
                <i class="fas fa-map-marker-alt"></i>
                <%= dhaba.location %>
            </p>

            <div class="dining-specs-bar">
                <div class="spec-item">
                    <div class="spec-item__icon"><i class="fas fa-star"></i></div>
                    <div class="spec-item__label">Rating</div>
                    <div class="spec-item__value"><%= dhaba.rating || '4.5' %></div>
                </div>
                <div class="spec-item">
                    <div class="spec-item__icon"><i class="fas fa-rupee-sign"></i></div>
                    <div class="spec-item__label">Price Range</div>
                    <div class="spec-item__value"><%= dhaba.priceRange || '₹₹' %></div>
                </div>
                <div class="spec-item">
                    <div class="spec-item__icon"><i class="fas fa-clock"></i></div>
                    <div class="spec-item__label">Timings</div>
                    <div class="spec-item__value"><%= dhaba.timings ? dhaba.timings.open : '6 AM' %> – <%= dhaba.timings ? dhaba.timings.close : '11 PM' %></div>
                </div>
                <% if(dhaba.contact) { %>
                <div class="spec-item">
                    <div class="spec-item__icon"><i class="fas fa-phone"></i></div>
                    <div class="spec-item__label">Contact</div>
                    <div class="spec-item__value"><%= dhaba.contact %></div>
                </div>
                <% } %>
            </div>

            <% if(dhaba.cuisine && dhaba.cuisine.length > 0) { %>
                <div class="cuisine-tags">
                    <% dhaba.cuisine.forEach(c => { %>
                        <span class="cuisine-tag"><%= c %></span>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <!-- ===================================
             DESCRIPTION + RESERVATION GRID
             =================================== -->
        <div class="detail-grid">
            <!-- Left: Description -->
            <div class="detail-description">
                <% if(dhaba.description) { %>
                    <p class="section-label">About This Place</p>
                    <p class="detail-description__text"><%= dhaba.description %></p>
                <% } %>

                <!-- Specialties -->
                <% if(dhaba.specialties && dhaba.specialties.length > 0) { %>
                    <div class="specialties-section">
                        <p class="section-label">Must Try Dishes</p>
                        <div class="specialties-grid">
                            <% dhaba.specialties.forEach(item => { %>
                                <span class="specialty-pill">🍽️ <%= item %></span>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <!-- Features -->
                <% if(dhaba.features && dhaba.features.length > 0) { %>
                    <div class="features-section">
                        <p class="section-label">Amenities</p>
                        <div class="features-grid">
                            <% dhaba.features.forEach(feature => { %>
                                <div class="feature-item">
                                    <i class="fas fa-check"></i>
                                    <span><%= feature %></span>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <!-- Host Card -->
                <% if(dhaba.owner) { %>
                    <div class="host-card">
                        <div class="host-avatar">
                            <%= dhaba.owner.username.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <div class="host-info__name">Listed by <%= dhaba.owner.username %></div>
                            <div class="host-info__badge">Local Food Expert</div>
                        </div>
                    </div>

                    <% if(currUser && dhaba.owner._id.equals(currUser._id)) { %>
                        <div class="owner-actions">
                            <a href="/dhabas/<%= dhaba._id %>/edit" class="owner-btn owner-btn--edit">
                                <i class="fas fa-edit"></i> Edit Dining
                            </a>
                            <form method="POST" action="/dhabas/<%= dhaba._id %>?_method=DELETE" style="flex: 1;">
                                <button type="submit" class="owner-btn owner-btn--delete" style="width: 100%;" onclick="return confirm('Delete this dining spot?');">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    <% } %>
                <% } %>
            </div>

            <!-- Right: Reservation Card -->
            <div>
                <div class="booking-card">
                    <div class="booking-card__title">Make a Reservation</div>
                    <div class="booking-card__subtitle">Reserve your table in advance</div>
                    <div class="booking-card__divider"></div>

                    <% if(currUser) { %>
                        <form action="/dhabas/<%= dhaba._id %>/book" method="POST">
                            <div class="booking-card__row">
                                <div>
                                    <label class="booking-card__label">Date</label>
                                    <input type="date" class="booking-card__input" name="date" required
                                        min="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                                <div>
                                    <label class="booking-card__label">Time</label>
                                    <select name="time" class="booking-card__input" required>
                                        <option value="12:00 PM">12:00 PM</option>
                                        <option value="1:00 PM">1:00 PM</option>
                                        <option value="2:00 PM">2:00 PM</option>
                                        <option value="7:00 PM" selected>7:00 PM</option>
                                        <option value="8:00 PM">8:00 PM</option>
                                        <option value="9:00 PM">9:00 PM</option>
                                    </select>
                                </div>
                            </div>

                            <label class="booking-card__label">Guests</label>
                            <select name="guests" class="booking-card__input" required>
                                <option value="1">1 Guest</option>
                                <option value="2" selected>2 Guests</option>
                                <option value="3">3 Guests</option>
                                <option value="4">4 Guests</option>
                                <option value="5">5 Guests</option>
                                <option value="6">6+ Guests</option>
                            </select>

                            <button type="submit" class="booking-card__submit">
                                Reserve a Table
                            </button>
                            <p class="booking-card__note">₹100 reservation fee (adjustable against bill)</p>
                        </form>
                    <% } else { %>
                        <a href="/login" class="booking-card__login">
                            Sign In to Reserve
                        </a>
                        <p class="booking-card__note">Create an account to make a reservation.</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- ===================================
             MAP SECTION
             =================================== -->
        <div class="map-section">
            <p class="section-label">Location</p>
            <h3 class="map-section__title">Find Us Here</h3>
            <p class="map-section__subtitle">
                <i class="fas fa-map-marker-alt"></i>
                <%= dhaba.location %>
            </p>
            <div id="map"></div>
        </div>

    </div>
</div>

<script>
    var maptoken = "<%- mapBoxToken || '' %>";
    var dhaba = <%- JSON.stringify(dhaba) %>;

    // ===================================
    // IMAGE GALLERY CAROUSEL
    // ===================================
    let currentSlide = 0;
    const slides = document.querySelectorAll('#heroGallery img');
    const dots = document.querySelectorAll('.hero-dot');
    const counter = document.getElementById('slideNum');

    function changeSlide(direction) {
        currentSlide += direction;
        if (currentSlide >= slides.length) currentSlide = 0;
        if (currentSlide < 0) currentSlide = slides.length - 1;
        goToSlide(currentSlide);
    }

    function goToSlide(idx) {
        slides.forEach(s => s.classList.remove('active'));
        dots.forEach(d => d.classList.remove('active'));
        slides[idx].classList.add('active');
        if (dots[idx]) dots[idx].classList.add('active');
        if (counter) counter.textContent = idx + 1;
        currentSlide = idx;
    }

    // Auto-advance every 5 seconds
    <% if(allImages.length > 1) { %>
    setInterval(() => changeSlide(1), 5000);
    <% } %>

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (document.getElementById('dhabaLightbox').classList.contains('active')) return;
        if (e.key === 'ArrowLeft') changeSlide(-1);
        if (e.key === 'ArrowRight') changeSlide(1);
    });

    // ===================================
    // LIGHTBOX
    // ===================================
    const galleryImages = <%- JSON.stringify(allImages.map(i => i.url)) %>;
    let lbIndex = 0;

    function openLightbox(idx) {
        lbIndex = idx;
        document.getElementById('lbImage').src = galleryImages[lbIndex];
        document.getElementById('lbCounter').textContent = (lbIndex + 1) + ' / ' + galleryImages.length;
        document.getElementById('dhabaLightbox').classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
        document.getElementById('dhabaLightbox').classList.remove('active');
        document.body.style.overflow = '';
    }
    function lbNav(dir) {
        lbIndex += dir;
        if (lbIndex >= galleryImages.length) lbIndex = 0;
        if (lbIndex < 0) lbIndex = galleryImages.length - 1;
        document.getElementById('lbImage').src = galleryImages[lbIndex];
        document.getElementById('lbCounter').textContent = (lbIndex + 1) + ' / ' + galleryImages.length;
    }
    document.addEventListener('keydown', (e) => {
        if (!document.getElementById('dhabaLightbox').classList.contains('active')) return;
        if (e.key === 'ArrowLeft') lbNav(-1);
        if (e.key === 'ArrowRight') lbNav(1);
        if (e.key === 'Escape') closeLightbox();
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const mapContainer = document.getElementById('map');
        if (!mapContainer) return;

        if (!maptoken) {
            mapContainer.innerHTML = '<p style="padding: 2rem; text-align: center; color: #717171;">Map unavailable - Token not configured</p>';
            return;
        }

        if (!dhaba.geometry || !dhaba.geometry.coordinates) {
            mapContainer.innerHTML = '<p style="padding: 2rem; text-align: center; color: #717171;">Location not available for this restaurant</p>';
            return;
        }

        try {
            mapboxgl.accessToken = maptoken;
            const [lng, lat] = dhaba.geometry.coordinates;

            const map = new mapboxgl.Map({
                container: 'map',
                style: 'mapbox://styles/mapbox/streets-v12',
                center: [lng, lat],
                zoom: 14
            });

            map.addControl(new mapboxgl.NavigationControl(), 'top-right');

            new mapboxgl.Marker({ color: '#C9A227' })
                .setLngLat([lng, lat])
                .setPopup(
                    new mapboxgl.Popup({ offset: 25 })
                        .setHTML(`
                            <div style="padding: 0.5rem;">
                                <h4 style="margin: 0 0 0.5rem; font-weight: 600;">${dhaba.title}</h4>
                                <p style="margin: 0; color: #717171; font-size: 0.875rem;">${dhaba.location}</p>
                                <p style="margin: 0.5rem 0 0; font-size: 0.75rem; color: #C9A227;">🍽️ ${dhaba.category || 'Dining'}</p>
                            </div>
                        `)
                )
                .addTo(map);
        } catch (error) {
            console.error('Map error:', error);
            mapContainer.innerHTML = '<p style="padding: 2rem; text-align: center; color: #717171;">Unable to load map</p>';
        }
    });
</script>