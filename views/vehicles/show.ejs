<% layout("layouts/boilerplate")%>

<style>
    /* ===================================
       FOUR SEASONS LUXURY VEHICLE PAGE
       =================================== */
    
    :root {
        --fs-gold: #C9A227;
        --fs-gold-light: #E8D5A3;
        --fs-dark: #1A1A1A;
        --fs-dark-soft: #2A2A2A;
        --fs-cream: #FAF8F5;
        --fs-text: #333;
        --fs-text-light: #717171;
        --fs-border: #E8E8E8;
        --fs-serif: 'Playfair Display', Georgia, serif;
        --fs-sans: 'Plus Jakarta Sans', 'Helvetica Neue', sans-serif;
        --fs-elegant: 'Cormorant Garamond', Georgia, serif;
    }

    .vehicle-detail-page {
        margin-top: -1rem;
    }

    /* ===================================
       HERO IMAGE GALLERY
       =================================== */
    
    .detail-hero {
        position: relative;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        height: 85vh;
        min-height: 550px;
        max-height: 850px;
        overflow: hidden;
        background: var(--fs-dark);
    }

    .detail-hero img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
        animation: heroFadeIn 0.6s ease;
    }

    .detail-hero img.active {
        display: block;
    }

    @keyframes heroFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .detail-hero__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(0,0,0,0.3) 0%,
            rgba(0,0,0,0.05) 40%,
            rgba(0,0,0,0.05) 60%,
            rgba(0,0,0,0.6) 100%
        );
        z-index: 1;
    }

    .detail-hero__content {
        position: absolute;
        bottom: 3rem;
        left: 0;
        right: 0;
        z-index: 2;
        text-align: center;
        padding: 0 2rem;
    }

    .detail-hero__eyebrow {
        font-family: var(--fs-elegant);
        font-size: 1rem;
        font-style: italic;
        color: var(--fs-gold-light);
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
    }

    .detail-hero__title {
        font-family: var(--fs-serif);
        font-size: clamp(1.75rem, 4vw, 3rem);
        font-weight: 400;
        color: white;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
    }

    .detail-hero__location {
        font-family: var(--fs-sans);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.8);
    }

    /* Gallery Navigation */
    .hero-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.25);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
        z-index: 3;
    }

    .hero-nav:hover {
        background: rgba(255,255,255,0.3);
        transform: translateY(-50%) scale(1.05);
    }

    .hero-prev { left: 2rem; }
    .hero-next { right: 2rem; }

    .hero-dots {
        position: absolute;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
        z-index: 3;
    }

    .hero-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,0.4);
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0;
    }

    .hero-dot.active {
        background: var(--fs-gold);
        transform: scale(1.4);
    }

    .hero-counter {
        position: absolute;
        top: 1.5rem;
        right: 2rem;
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(8px);
        color: white;
        padding: 0.4rem 1rem;
        font-family: var(--fs-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        z-index: 3;
    }

    .hero-back {
        position: absolute;
        top: 1.5rem;
        left: 2rem;
        z-index: 3;
        color: white;
        text-decoration: none;
        font-family: var(--fs-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: rgba(0,0,0,0.4);
        backdrop-filter: blur(8px);
        transition: all 0.3s ease;
    }

    .hero-back:hover {
        background: rgba(0,0,0,0.7);
        color: var(--fs-gold-light);
    }

    .hero-view-all {
        position: absolute;
        bottom: 1.5rem;
        right: 2rem;
        z-index: 3;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        padding: 0.6rem 1.25rem;
        font-family: var(--fs-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .hero-view-all:hover {
        background: rgba(255,255,255,0.3);
    }

    /* ===================================
       CONTENT AREA
       =================================== */
    
    .detail-content {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* ===================================
       VEHICLE INTRO SECTION
       =================================== */
    
    .vehicle-intro {
        text-align: center;
        padding: 4rem 0 3rem;
        border-bottom: 1px solid var(--fs-border);
    }

    .vehicle-intro__type {
        font-family: var(--fs-elegant);
        font-size: 1rem;
        font-style: italic;
        color: var(--fs-gold);
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
        text-transform: capitalize;
    }

    .vehicle-intro__title {
        font-family: var(--fs-serif);
        font-size: clamp(1.75rem, 3.5vw, 2.75rem);
        font-weight: 400;
        color: var(--fs-dark);
        margin-bottom: 1rem;
        letter-spacing: 0.03em;
    }

    .vehicle-intro__location {
        font-family: var(--fs-sans);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--fs-text-light);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .vehicle-intro__location i {
        color: var(--fs-gold);
    }

    /* Vehicle Specs */
    .vehicle-specs-bar {
        display: flex;
        justify-content: center;
        gap: 0;
        margin-top: 2.5rem;
    }

    .spec-item {
        text-align: center;
        padding: 0 2.5rem;
        border-right: 1px solid var(--fs-border);
    }

    .spec-item:last-child {
        border-right: none;
    }

    .spec-item__icon {
        font-size: 1.25rem;
        color: var(--fs-gold);
        margin-bottom: 0.5rem;
    }

    .spec-item__label {
        font-family: var(--fs-sans);
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--fs-text-light);
        margin-bottom: 0.25rem;
    }

    .spec-item__value {
        font-family: var(--fs-serif);
        font-size: 1.1rem;
        color: var(--fs-dark);
    }

    /* ===================================
       MAIN GRID (Description + Booking)
       =================================== */
    
    .detail-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 4rem;
        padding: 3rem 0;
    }

    .detail-description {
        padding-right: 2rem;
    }

    .section-label {
        font-family: var(--fs-sans);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--fs-gold);
        margin-bottom: 1rem;
    }

    .detail-description__text {
        font-family: var(--fs-elegant);
        font-size: 1.15rem;
        line-height: 1.8;
        color: var(--fs-text);
    }

    /* Features Section */
    .features-section {
        margin-top: 2.5rem;
        padding-top: 2.5rem;
        border-top: 1px solid var(--fs-border);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1rem;
        border-bottom: 1px solid #f0f0f0;
        font-family: var(--fs-sans);
        font-size: 0.85rem;
        color: var(--fs-text);
    }

    .feature-item i {
        color: var(--fs-gold);
        width: 20px;
        text-align: center;
        font-size: 1rem;
    }

    /* Host Card */
    .host-card {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 2.5rem;
        padding: 1.5rem;
        background: var(--fs-cream);
    }

    .host-avatar {
        width: 56px;
        height: 56px;
        background: var(--fs-dark);
        color: var(--fs-gold-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--fs-serif);
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .host-info__name {
        font-family: var(--fs-serif);
        font-size: 1.1rem;
        color: var(--fs-dark);
        margin-bottom: 0.15rem;
    }

    .host-info__badge {
        font-family: var(--fs-sans);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--fs-gold);
    }

    /* Owner Actions */
    .owner-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .owner-btn {
        flex: 1;
        padding: 0.85rem 1.5rem;
        font-family: var(--fs-sans);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-align: center;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .owner-btn--edit {
        background: var(--fs-dark);
        color: white;
    }

    .owner-btn--edit:hover {
        background: #333;
        color: var(--fs-gold-light);
    }

    .owner-btn--delete {
        background: transparent;
        color: #c0392b;
        border: 1px solid #c0392b;
    }

    .owner-btn--delete:hover {
        background: #c0392b;
        color: white;
    }

    /* ===================================
       BOOKING CARD
       =================================== */
    
    .booking-card {
        position: sticky;
        top: 100px;
        background: white;
        border: 1px solid var(--fs-border);
        padding: 2.5rem 2rem;
    }

    .booking-card__price {
        font-family: var(--fs-serif);
        font-size: 2.25rem;
        font-weight: 400;
        color: var(--fs-dark);
        margin-bottom: 0.25rem;
    }

    .booking-card__price small {
        font-family: var(--fs-sans);
        font-size: 0.8rem;
        color: var(--fs-text-light);
        font-weight: 400;
    }

    .booking-card__divider {
        width: 40px;
        height: 2px;
        background: var(--fs-gold);
        margin: 1.25rem 0;
    }

    .booking-card__label {
        font-family: var(--fs-sans);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--fs-text-light);
        display: block;
        margin-bottom: 0.4rem;
    }

    .booking-card__input {
        width: 100%;
        padding: 0.85rem 1rem;
        border: 1px solid var(--fs-border);
        font-family: var(--fs-sans);
        font-size: 0.85rem;
        color: var(--fs-dark);
        background: white;
        transition: border-color 0.3s ease;
        outline: none;
    }

    .booking-card__input:focus {
        border-color: var(--fs-gold);
    }

    .booking-card__date-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .booking-card__submit {
        width: 100%;
        padding: 1.1rem;
        background: var(--fs-dark);
        color: white;
        border: none;
        font-family: var(--fs-sans);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .booking-card__submit:hover {
        background: var(--fs-gold);
        color: white;
    }

    .booking-card__login {
        display: block;
        text-align: center;
        text-decoration: none;
        width: 100%;
        padding: 1.1rem;
        background: var(--fs-dark);
        color: white;
        font-family: var(--fs-sans);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

    .booking-card__login:hover {
        background: var(--fs-gold);
        color: white;
    }

    .booking-card__note {
        text-align: center;
        font-family: var(--fs-sans);
        font-size: 0.75rem;
        color: var(--fs-text-light);
        margin-top: 0.75rem;
    }

    /* ===================================
       MAP SECTION
       =================================== */
    
    .map-section {
        padding: 3rem 0;
        border-top: 1px solid var(--fs-border);
    }

    .map-section__title {
        font-family: var(--fs-serif);
        font-size: 1.5rem;
        font-weight: 400;
        color: var(--fs-dark);
        margin-bottom: 0.5rem;
    }

    .map-section__subtitle {
        font-family: var(--fs-sans);
        font-size: 0.85rem;
        color: var(--fs-text-light);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .map-section__subtitle i {
        color: var(--fs-gold);
    }

    #map {
        height: 400px;
        background: #e9e9e9;
    }

    /* ===================================
       LIGHTBOX
       =================================== */

    .lb-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.95);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }
    .lb-overlay.active { display: flex; }
    .lb-close {
        position: absolute; top: 1.5rem; right: 2rem;
        background: none; border: none; color: white; font-size: 2rem; cursor: pointer; z-index: 10001;
    }
    .lb-counter {
        position: absolute; top: 1.5rem; left: 2rem;
        color: rgba(255,255,255,0.7); font-family: var(--fs-sans); font-size: 0.85rem;
        font-weight: 600; letter-spacing: 0.1em; z-index: 10001;
    }
    .lb-img-wrap { max-width: 85vw; max-height: 85vh; }
    .lb-img-wrap img { max-width: 85vw; max-height: 85vh; object-fit: contain; }
    .lb-nav {
        position: absolute; top: 50%; transform: translateY(-50%);
        background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25);
        width: 48px; height: 48px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; color: white; font-size: 1rem;
        transition: all 0.3s ease; z-index: 10001;
    }
    .lb-nav:hover { background: rgba(255,255,255,0.3); }
    .lb-prev { left: 2rem; }
    .lb-next { right: 2rem; }

    /* ===================================
       RESPONSIVE
       =================================== */

    @media (max-width: 768px) {
        .detail-hero { height: 60vh; min-height: 350px; }
        .detail-grid { grid-template-columns: 1fr; gap: 2rem; }
        .detail-description { padding-right: 0; }
        .vehicle-specs-bar { flex-wrap: wrap; gap: 1rem; }
        .spec-item { border-right: none; padding: 0 1.5rem; }
    }
</style>

<!-- Lightbox Modal -->
<div class="lb-overlay" id="vehicleLightbox">
    <button class="lb-close" onclick="closeLightbox()">&times;</button>
    <span class="lb-counter" id="lbCounter"></span>
    <button class="lb-nav lb-prev" onclick="lbNav(-1)"><i class="fas fa-chevron-left"></i></button>
    <button class="lb-nav lb-next" onclick="lbNav(1)"><i class="fas fa-chevron-right"></i></button>
    <div class="lb-img-wrap">
        <img src="" alt="Gallery image" id="lbImage">
    </div>
</div>

<div class="vehicle-detail-page">

    <!-- ===================================
         FULL-WIDTH HERO IMAGE GALLERY
         =================================== -->
    <section class="detail-hero" id="heroGallery">
        <%
          let allImages = [];
          if(vehicle.images && vehicle.images.length > 0) {
            allImages = vehicle.images;
          } else if(vehicle.image && vehicle.image.url) {
            allImages = [vehicle.image];
          } else {
            allImages = [{ url: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1200' }];
          }
        %>
        <% allImages.forEach((img, idx) => { %>
            <img src="<%= img.url %>" alt="<%= vehicle.title %> - Photo <%= idx + 1 %>" class="<%= idx === 0 ? 'active' : '' %>">
        <% }); %>

        <div class="detail-hero__overlay"></div>

        <!-- Back Button -->
        <a href="/vehicles" class="hero-back">
            <i class="fas fa-arrow-left"></i> Back to Vehicles
        </a>

        <!-- Counter -->
        <% if(allImages.length > 1) { %>
            <div class="hero-counter"><span id="slideNum">1</span> / <%= allImages.length %></div>
        <% } %>

        <!-- Title Overlay -->
        <div class="detail-hero__content">
            <p class="detail-hero__eyebrow"><%= vehicle.vehicleType || 'Premium Vehicle' %></p>
            <h1 class="detail-hero__title"><%= vehicle.title %></h1>
            <p class="detail-hero__location">
                <i class="fas fa-map-marker-alt"></i>
                <%= vehicle.mapboxPlaceName ? vehicle.mapboxPlaceName : vehicle.location %>
            </p>
        </div>

        <!-- Navigation -->
        <% if(allImages.length > 1) { %>
            <button class="hero-nav hero-prev" onclick="changeSlide(-1)"><i class="fas fa-chevron-left"></i></button>
            <button class="hero-nav hero-next" onclick="changeSlide(1)"><i class="fas fa-chevron-right"></i></button>
            <div class="hero-dots">
                <% allImages.forEach((img, idx) => { %>
                    <button class="hero-dot <%= idx === 0 ? 'active' : '' %>" onclick="goToSlide(<%= idx %>)"></button>
                <% }); %>
            </div>
        <% } %>

        <!-- View All Photos -->
        <% if(allImages.length > 1) { %>
            <button class="hero-view-all" onclick="openLightbox(0)">
                <i class="fas fa-images"></i> View All Photos (<%= allImages.length %>)
            </button>
        <% } %>
    </section>

    <div class="detail-content">

        <!-- ===================================
             VEHICLE INTRO
             =================================== -->
        <div class="vehicle-intro">
            <p class="vehicle-intro__type"><%= vehicle.vehicleType || 'Premium Vehicle' %></p>
            <h2 class="vehicle-intro__title"><%= vehicle.title %></h2>
            <p class="vehicle-intro__location">
                <i class="fas fa-map-marker-alt"></i>
                <%= vehicle.mapboxPlaceName ? vehicle.mapboxPlaceName : vehicle.location %>
            </p>

            <div class="vehicle-specs-bar">
                <div class="spec-item">
                    <div class="spec-item__icon"><i class="fas fa-gas-pump"></i></div>
                    <div class="spec-item__label">Fuel</div>
                    <div class="spec-item__value"><%= vehicle.fuelType || 'Petrol' %></div>
                </div>
                <div class="spec-item">
                    <div class="spec-item__icon"><i class="fas fa-cog"></i></div>
                    <div class="spec-item__label">Transmission</div>
                    <div class="spec-item__value"><%= vehicle.transmission || 'Manual' %></div>
                </div>
                <div class="spec-item">
                    <div class="spec-item__icon"><i class="fas fa-users"></i></div>
                    <div class="spec-item__label">Seats</div>
                    <div class="spec-item__value"><%= vehicle.seats || 2 %></div>
                </div>
                <div class="spec-item">
                    <div class="spec-item__icon"><i class="fas fa-calendar"></i></div>
                    <div class="spec-item__label">Year</div>
                    <div class="spec-item__value"><%= vehicle.year || 'N/A' %></div>
                </div>
                <% if(vehicle.brand) { %>
                <div class="spec-item">
                    <div class="spec-item__icon"><i class="fas fa-award"></i></div>
                    <div class="spec-item__label">Brand</div>
                    <div class="spec-item__value"><%= vehicle.brand %></div>
                </div>
                <% } %>
            </div>
        </div>

        <!-- ===================================
             DESCRIPTION + BOOKING GRID
             =================================== -->
        <div class="detail-grid">
            <!-- Left: Description -->
            <div class="detail-description">
                <% if(vehicle.description) { %>
                    <p class="section-label">About This Vehicle</p>
                    <p class="detail-description__text"><%= vehicle.description %></p>
                <% } %>

                <!-- Features -->
                <% if(vehicle.features && vehicle.features.length > 0) { %>
                    <div class="features-section">
                        <p class="section-label">Features Included</p>
                        <div class="features-grid">
                            <% vehicle.features.forEach(feature => { %>
                                <div class="feature-item">
                                    <i class="fas fa-check"></i>
                                    <span><%= feature %></span>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <!-- Host Card -->
                <% if(vehicle.owner) { %>
                    <div class="host-card">
                        <div class="host-avatar">
                            <%= vehicle.owner.username.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <div class="host-info__name">Listed by <%= vehicle.owner.username %></div>
                            <div class="host-info__badge">Vehicle Owner</div>
                        </div>
                    </div>

                    <% if(currUser && vehicle.owner._id.equals(currUser._id)) { %>
                        <div class="owner-actions">
                            <a href="/vehicles/<%= vehicle._id %>/edit" class="owner-btn owner-btn--edit">
                                <i class="fas fa-edit"></i> Edit Vehicle
                            </a>
                            <form method="POST" action="/vehicles/<%= vehicle._id %>?_method=DELETE" style="flex: 1;">
                                <button type="submit" class="owner-btn owner-btn--delete" style="width: 100%;" onclick="return confirm('Delete this vehicle?');">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    <% } %>
                <% } %>
            </div>

            <!-- Right: Booking Card -->
            <div>
                <div class="booking-card">
                    <div class="booking-card__price">
                        ₹<%= vehicle.pricePerDay.toLocaleString("en-IN") %>
                        <small>/ day</small>
                    </div>
                    <div class="booking-card__divider"></div>

                    <% if(currUser) { %>
                        <form action="/vehicles/<%= vehicle._id %>/book" method="POST">
                            <div class="booking-card__date-grid">
                                <div>
                                    <label class="booking-card__label">Pick-Up</label>
                                    <input type="date" class="booking-card__input" name="checkIn" required
                                        min="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                                <div>
                                    <label class="booking-card__label">Drop-Off</label>
                                    <input type="date" class="booking-card__input" name="checkOut" required
                                        min="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                            </div>

                            <button type="submit" class="booking-card__submit">
                                Book Now
                            </button>
                            <p class="booking-card__note">Free cancellation up to 24 hours before pickup.</p>
                        </form>
                    <% } else { %>
                        <a href="/login" class="booking-card__login">
                            Sign In to Book
                        </a>
                        <p class="booking-card__note">Create an account to unlock booking.</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- ===================================
             MAP SECTION
             =================================== -->
        <div class="map-section">
            <p class="section-label">Location</p>
            <h3 class="map-section__title">Pickup Location</h3>
            <p class="map-section__subtitle">
                <i class="fas fa-map-marker-alt"></i>
                <%= vehicle.mapboxPlaceName ? vehicle.mapboxPlaceName : vehicle.location %>
            </p>
            <div id="map"></div>
        </div>

    </div>
</div>

<script>
    var maptoken = "<%- mapBoxToken || '' %>";
    var vehicle = <%- JSON.stringify(vehicle) %>;

    // ===================================
    // IMAGE GALLERY CAROUSEL
    // ===================================
    let currentSlide = 0;
    const slides = document.querySelectorAll('#heroGallery img');
    const dots = document.querySelectorAll('.hero-dot');
    const counter = document.getElementById('slideNum');

    function changeSlide(direction) {
        currentSlide += direction;
        if (currentSlide >= slides.length) currentSlide = 0;
        if (currentSlide < 0) currentSlide = slides.length - 1;
        goToSlide(currentSlide);
    }

    function goToSlide(idx) {
        slides.forEach(s => s.classList.remove('active'));
        dots.forEach(d => d.classList.remove('active'));
        slides[idx].classList.add('active');
        if (dots[idx]) dots[idx].classList.add('active');
        if (counter) counter.textContent = idx + 1;
        currentSlide = idx;
    }

    // Auto-advance every 5 seconds
    <% if(allImages.length > 1) { %>
    setInterval(() => changeSlide(1), 5000);
    <% } %>

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (document.getElementById('vehicleLightbox').classList.contains('active')) return;
        if (e.key === 'ArrowLeft') changeSlide(-1);
        if (e.key === 'ArrowRight') changeSlide(1);
    });

    // ===================================
    // LIGHTBOX
    // ===================================
    const galleryImages = <%- JSON.stringify(allImages.map(i => i.url)) %>;
    let lbIndex = 0;

    function openLightbox(idx) {
        lbIndex = idx;
        document.getElementById('lbImage').src = galleryImages[lbIndex];
        document.getElementById('lbCounter').textContent = (lbIndex + 1) + ' / ' + galleryImages.length;
        document.getElementById('vehicleLightbox').classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
        document.getElementById('vehicleLightbox').classList.remove('active');
        document.body.style.overflow = '';
    }
    function lbNav(dir) {
        lbIndex += dir;
        if (lbIndex >= galleryImages.length) lbIndex = 0;
        if (lbIndex < 0) lbIndex = galleryImages.length - 1;
        document.getElementById('lbImage').src = galleryImages[lbIndex];
        document.getElementById('lbCounter').textContent = (lbIndex + 1) + ' / ' + galleryImages.length;
    }
    document.addEventListener('keydown', (e) => {
        if (!document.getElementById('vehicleLightbox').classList.contains('active')) return;
        if (e.key === 'ArrowLeft') lbNav(-1);
        if (e.key === 'ArrowRight') lbNav(1);
        if (e.key === 'Escape') closeLightbox();
    });
</script>
<script src="/js/map.js"></script>