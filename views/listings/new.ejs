<% layout("layouts/boilerplate")%>

  <style>
    /* ===== ANIMATED FORM PAGE ===== */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes shimmer {
      0% {
        background-position: -200% center;
      }

      100% {
        background-position: 200% center;
      }
    }

    .form-page {
      max-width: 720px;
      margin: 2.5rem auto;
      padding: 0 1rem;
      animation: fadeIn 0.6s ease;
    }

    .form-card {
      background: #fff;
      border-radius: 20px;
      padding: 2.5rem;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
      border: 1px solid rgba(0, 0, 0, 0.06);
      animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .form-card h3 {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, #1a1a1a, #555);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: slideInLeft 0.6s ease 0.2s both;
    }

    .form-subtitle {
      color: #717171;
      font-size: 0.95rem;
      margin-bottom: 2rem;
      animation: slideInLeft 0.6s ease 0.3s both;
    }

    .form-divider {
      height: 3px;
      background: linear-gradient(90deg, #FF385C, #C9A227, #FF385C);
      background-size: 200% auto;
      animation: shimmer 3s linear infinite;
      border-radius: 2px;
      margin-bottom: 2rem;
      width: 80px;
    }

    /* Staggered field animations */
    .form-field {
      animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .form-field:nth-child(1) {
      animation-delay: 0.15s;
    }

    .form-field:nth-child(2) {
      animation-delay: 0.25s;
    }

    .form-field:nth-child(3) {
      animation-delay: 0.35s;
    }

    .form-field:nth-child(4) {
      animation-delay: 0.45s;
    }

    .form-field:nth-child(5) {
      animation-delay: 0.55s;
    }

    .form-field:nth-child(6) {
      animation-delay: 0.65s;
    }

    /* Input styling */
    .form-card .form-control {
      border: 2px solid #e8e8e8;
      border-radius: 12px;
      padding: 0.75rem 1rem;
      font-size: 0.95rem;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      background: #fafafa;
    }

    .form-card .form-control:focus {
      border-color: #FF385C;
      box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.1);
      background: #fff;
      transform: translateY(-1px);
    }

    .form-card .form-label {
      font-weight: 600;
      font-size: 0.9rem;
      color: #333;
      margin-bottom: 0.4rem;
    }

    /* Photo upload section */
    .photo-section {
      background: #f8f8f8;
      border-radius: 16px;
      padding: 1.5rem;
      border: 2px dashed #ddd;
      transition: all 0.3s ease;
    }

    .photo-section:hover {
      border-color: #FF385C;
      background: #fff5f7;
    }

    .photo-section .form-control[type="file"] {
      background: #fff;
    }

    /* Submit button */
    .btn-submit {
      background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
      color: white;
      border: none;
      border-radius: 12px;
      padding: 0.85rem 2.5rem;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.5px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      animation: fadeInUp 0.5s ease 0.75s both;
    }

    .btn-submit::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
      transition: left 0.5s ease;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
      color: white;
    }

    .btn-submit:hover::before {
      left: 100%;
    }

    .btn-submit:active {
      transform: translateY(0);
    }
  </style>

  <div class="form-page">
    <div class="form-card">
      <h3>✨ Create a New Listing</h3>
      <p class="form-subtitle">Share your space with travelers around the world</p>
      <div class="form-divider"></div>

      <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="form-field mb-3">
          <label for="title" class="form-label">Title</label>
          <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control" required>
          <div class="invalid-feedback">Please enter a title</div>
        </div>

        <div class="form-field mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control" rows="3" placeholder="Describe your place..."
            required></textarea>
          <div class="invalid-feedback">Please enter a description</div>
        </div>

        <div class="form-field mb-3">
          <label class="form-label">📸 Upload Stay Images (5 photos)</label>
          <div class="photo-section">
            <div class="mb-2">
              <label class="form-label text-muted small">Photo 1 (Main Photo) *</label>
              <input name="listing[image]" type="file" class="form-control" accept="image/*" required>
              <div class="invalid-feedback">Please upload the main photo</div>
            </div>
            <div class="mb-2">
              <label class="form-label text-muted small">Photo 2</label>
              <input name="listing[image]" type="file" class="form-control" accept="image/*">
            </div>
            <div class="mb-2">
              <label class="form-label text-muted small">Photo 3</label>
              <input name="listing[image]" type="file" class="form-control" accept="image/*">
            </div>
            <div class="mb-2">
              <label class="form-label text-muted small">Photo 4</label>
              <input name="listing[image]" type="file" class="form-control" accept="image/*">
            </div>
            <div class="mb-2">
              <label class="form-label text-muted small">Photo 5</label>
              <input name="listing[image]" type="file" class="form-control" accept="image/*">
            </div>
          </div>
        </div>

        <div class="form-field row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">💰 Price</label>
            <input name="listing[price]" placeholder="₹1200" class="form-control" required>
            <div class="invalid-feedback">Please enter a valid price</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">🌍 Country</label>
            <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
            <div class="invalid-feedback">Please enter a country</div>
          </div>
        </div>

        <div class="form-field mb-4">
          <label for="location" class="form-label">📍 Location</label>
          <input name="listing[location]" placeholder="Pune, Maharashtra" type="text" class="form-control" required>
        </div>

        <!-- Property Type & Category -->
        <div class="form-field row">
          <div class="mb-3 col-md-6">
            <label class="form-label">🏠 Property Type</label>
            <select name="listing[propertyType]" class="form-control">
              <option value="Entire place">Entire place</option>
              <option value="Private room">Private room</option>
              <option value="Shared room">Shared room</option>
              <option value="Hotel room">Hotel room</option>
            </select>
          </div>
          <div class="mb-3 col-md-6">
            <label class="form-label">🏷️ Category</label>
            <select name="listing[category]" class="form-control">
              <option value="Trending">Trending</option>
              <option value="Rooms">Rooms</option>
              <option value="Iconic Cities">Iconic Cities</option>
              <option value="Mountains">Mountains</option>
              <option value="Castles">Castles</option>
              <option value="Amazing Pools">Amazing Pools</option>
              <option value="Camping">Camping</option>
              <option value="Farms">Farms</option>
              <option value="Beach">Beach</option>
              <option value="Arctic">Arctic</option>
              <option value="Caves">Caves</option>
              <option value="Luxe">Luxe</option>
              <option value="Countryside">Countryside</option>
              <option value="Lakefront">Lakefront</option>
              <option value="Treehouses">Treehouses</option>
              <option value="Tiny homes">Tiny homes</option>
            </select>
          </div>
        </div>

        <!-- Capacity: Guests, Bedrooms, Beds, Bathrooms -->
        <div class="form-field row">
          <div class="mb-3 col-md-3 col-6">
            <label class="form-label">👥 Guests</label>
            <input type="number" name="listing[guests]" class="form-control" value="1" min="1">
          </div>
          <div class="mb-3 col-md-3 col-6">
            <label class="form-label">🛏️ Bedrooms</label>
            <input type="number" name="listing[bedrooms]" class="form-control" value="1" min="0">
          </div>
          <div class="mb-3 col-md-3 col-6">
            <label class="form-label">🛌 Beds</label>
            <input type="number" name="listing[beds]" class="form-control" value="1" min="1">
          </div>
          <div class="mb-3 col-md-3 col-6">
            <label class="form-label">🚿 Bathrooms</label>
            <input type="number" name="listing[bathrooms]" class="form-control" value="1" min="0" step="0.5">
          </div>
        </div>

        <!-- Amenities -->
        <div class="form-field mb-4">
          <label class="form-label">✨ Amenities</label>
          <p style="color: #999; font-size: 0.82rem; margin-bottom: 0.75rem;">Select all that apply</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0.5rem;">
            <% const amenitiesList = ['WiFi','Kitchen','Washer','Dryer','Air conditioning','Heating','TV','Pool','Hot tub','Free parking','EV charger','Gym','Breakfast','Workspace','Fireplace','Piano','BBQ grill','Beach access','Smoke alarm','Carbon monoxide alarm']; %>
            <% const amenityIcons = {'WiFi':'fa-wifi','Kitchen':'fa-utensils','Washer':'fa-tshirt','Dryer':'fa-wind','Air conditioning':'fa-snowflake','Heating':'fa-fire','TV':'fa-tv','Pool':'fa-swimming-pool','Hot tub':'fa-hot-tub','Free parking':'fa-parking','EV charger':'fa-charging-station','Gym':'fa-dumbbell','Breakfast':'fa-coffee','Workspace':'fa-laptop','Fireplace':'fa-fire-alt','Piano':'fa-music','BBQ grill':'fa-drumstick-bite','Beach access':'fa-umbrella-beach','Smoke alarm':'fa-bell','Carbon monoxide alarm':'fa-shield-alt'}; %>
            <% amenitiesList.forEach(a => { %>
              <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.75rem; background: #fafafa; border: 2px solid #e8e8e8; border-radius: 10px; cursor: pointer; font-size: 0.85rem; transition: all 0.2s ease;"
                     onmouseover="this.style.borderColor='#C9A227'; this.style.background='#fff'"
                     onmouseout="if(!this.querySelector('input').checked){this.style.borderColor='#e8e8e8'; this.style.background='#fafafa'}">
                <input type="checkbox" name="listing[amenities]" value="<%= a %>" style="accent-color: #C9A227;"
                       onchange="let l=this.parentElement; if(this.checked){l.style.borderColor='#C9A227';l.style.background='#fdf8e8'}else{l.style.borderColor='#e8e8e8';l.style.background='#fafafa'}">
                <i class="fas <%= amenityIcons[a] || 'fa-check' %>" style="color: #C9A227; width: 16px; font-size: 0.8rem;"></i>
                <%= a %>
              </label>
            <% }); %>
          </div>
        </div>

        <button class="btn btn-submit">Create Listing →</button>
      </form>
    </div>
  </div>