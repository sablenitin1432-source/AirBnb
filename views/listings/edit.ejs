<% layout("/layouts/boilerplate") %>

<main class="listing-form-page">
    <div class="listing-form-card">
        <div class="listing-form-heading">
            <p class="form-eyebrow">Keep your space up to date</p>
            <h1>Edit your listing</h1>
            <p>Refresh the details travelers see before they arrive.</p>
        </div>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate
            class="needs-validation listing-form" enctype="multipart/form-data">
            <fieldset class="form-section">
                <legend>Basic information</legend>
                <p class="form-section-description">Update the way your property is introduced.</p>
                <div class="form-field">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" id="title" value="<%= listing.title %>" type="text"
                        class="form-control" required />
                    <div class="valid-feedback">Title looks good!</div>
                </div>
                <div class="form-field">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" id="description" class="form-control"
                        required><%= listing.description %></textarea>
                    <div class="invalid-feedback">Please enter a short description</div>
                </div>
            </fieldset>

            <fieldset class="form-section">
                <legend>Property details</legend>
                <p class="form-section-description">Keep your stay information accurate and helpful.</p>
                <div class="form-grid form-grid-three">
                    <div class="form-field">
                        <label for="price" class="form-label">Price <span class="form-hint">per night</span></label>
                        <div class="form-input-prefix">
                            <span aria-hidden="true">&#8377;</span>
                            <input name="listing[price]" id="price" value="<%= listing.price %>" type="number"
                                class="form-control" required />
                        </div>
                        <div class="invalid-feedback">Price should be valid</div>
                    </div>
                    <div class="form-field">
                        <label for="category" class="form-label">Category</label>
                        <select name="listing[category]" id="category" class="form-control">
                            <option value="" <%= !listing.category ? "selected" : "" %>>Select a category</option>
                            <option value="Trending" <%= listing.category === "Trending" ? "selected" : "" %>>Trending</option>
                            <option value="Rooms" <%= listing.category === "Rooms" ? "selected" : "" %>>Rooms</option>
                            <option value="Iconic Cities" <%= listing.category === "Iconic Cities" ? "selected" : "" %>>Iconic Cities</option>
                            <option value="Mountains" <%= listing.category === "Mountains" ? "selected" : "" %>>Mountains</option>
                            <option value="Castles" <%= listing.category === "Castles" ? "selected" : "" %>>Castles</option>
                            <option value="Amazing Pools" <%= listing.category === "Amazing Pools" ? "selected" : "" %>>Amazing Pools</option>
                            <option value="Camping" <%= listing.category === "Camping" ? "selected" : "" %>>Camping</option>
                            <option value="Farms" <%= listing.category === "Farms" ? "selected" : "" %>>Farms</option>
                            <option value="Arctic" <%= listing.category === "Arctic" ? "selected" : "" %>>Arctic</option>
                            <option value="Domes" <%= listing.category === "Domes" ? "selected" : "" %>>Domes</option>
                            <option value="Boats" <%= listing.category === "Boats" ? "selected" : "" %>>Boats</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="propertyType" class="form-label">Property type</label>
                        <select name="listing[propertyType]" id="propertyType" class="form-control">
                            <option value="" <%= !listing.propertyType ? "selected" : "" %>>Select a type</option>
                            <option value="Entire place" <%= listing.propertyType === "Entire place" ? "selected" : "" %>>Entire place</option>
                            <option value="Private room" <%= listing.propertyType === "Private room" ? "selected" : "" %>>Private room</option>
                            <option value="Hotel room" <%= listing.propertyType === "Hotel room" ? "selected" : "" %>>Hotel room</option>
                            <option value="Apartment" <%= listing.propertyType === "Apartment" ? "selected" : "" %>>Apartment</option>
                            <option value="Villa" <%= listing.propertyType === "Villa" ? "selected" : "" %>>Villa</option>
                            <option value="Cottage" <%= listing.propertyType === "Cottage" ? "selected" : "" %>>Cottage</option>
                            <option value="Cabin" <%= listing.propertyType === "Cabin" ? "selected" : "" %>>Cabin</option>
                            <option value="Lodge" <%= listing.propertyType === "Lodge" ? "selected" : "" %>>Lodge</option>
                            <option value="Treehouse" <%= listing.propertyType === "Treehouse" ? "selected" : "" %>>Treehouse</option>
                            <option value="Boat" <%= listing.propertyType === "Boat" ? "selected" : "" %>>Boat</option>
                        </select>
                    </div>
                </div>
                <div class="form-grid form-grid-two">
                    <div class="form-field">
                        <label for="guests" class="form-label">Guests</label>
                        <input name="listing[guests]" id="guests" value="<%= listing.guests ?? '' %>" type="number"
                            min="1" step="1" class="form-control" placeholder="2" />
                    </div>
                    <div class="form-field">
                        <label for="bedrooms" class="form-label">Bedrooms</label>
                        <input name="listing[bedrooms]" id="bedrooms" value="<%= listing.bedrooms ?? '' %>" type="number"
                            min="0" step="1" class="form-control" placeholder="1" />
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-section">
                <legend>Location</legend>
                <p class="form-section-description">Keep the location guests see up to date.</p>
                <div class="form-grid form-grid-two">
                    <div class="form-field">
                        <label for="location" class="form-label">Location</label>
                        <input name="listing[location]" id="location" value="<%= listing.location %>"
                            placeholder="Enter location" type="text" class="form-control" required />
                        <div class="invalid-feedback">Location should be valid</div>
                    </div>
                    <div class="form-field">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" id="country" value="<%= listing.country %>"
                            placeholder="Enter country" type="text" class="form-control" required />
                        <div class="invalid-feedback">Country name should be valid</div>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-section form-upload-field">
                <legend>Property image</legend>
                <p class="form-section-description">Keep the current photo or replace it with a new one.</p>
                <div class="current-image-panel">
                    <span class="current-image-label">Current listing image</span>
                    <img src="<%= originalImageUrl %>" class="current-listing-image" alt="Current listing image" />
                </div>
                <label for="image" class="upload-dropzone">
                    <span class="upload-icon"><i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i></span>
                    <span class="upload-title">Upload a new image</span>
                    <span class="upload-description">Choose a fresh image if you want to update the listing.</span>
                    <span class="upload-button">Choose image</span>
                    <input name="listing[image]" id="image" type="file" />
                </label>
            </fieldset>

            <div class="form-actions">
                <a href="/listings/<%= listing._id %>" class="form-cancel">Cancel</a>
                <button class="btn edit-btn form-submit" type="submit">Save changes</button>
            </div>
        </form>
    </div>
</main>
