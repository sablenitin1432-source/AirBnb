<style>
    /* ===================================
       ELITE PASSAGE - PREMIUM FOOTER
       =================================== */

    .elite-footer {
        background: linear-gradient(180deg, #0a0a0a 0%, #111111 40%, #0d0d0d 100%);
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-top: 0;
    }

    .elite-footer::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent 0%, #C6A75E 30%, #F0D78C 50%, #C6A75E 70%, transparent 100%);
    }

    /* Decorative background pattern */
    .elite-footer::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(ellipse at 20% 50%, rgba(198, 167, 94, 0.03) 0%, transparent 60%),
            radial-gradient(ellipse at 80% 80%, rgba(198, 167, 94, 0.02) 0%, transparent 50%);
        pointer-events: none;
    }

    .elite-footer__inner {
        position: relative;
        z-index: 1;
        max-width: 1280px;
        margin: 0 auto;
        padding: 5rem 3rem 0;
    }

    /* ── Top Section: Logo + Tagline ── */
    .elite-footer__top {
        text-align: center;
        padding-bottom: 4rem;
        border-bottom: 1px solid rgba(198, 167, 94, 0.15);
    }

    .elite-footer__logo {
        margin-bottom: 1.5rem;
    }

    .elite-footer__tagline {
        font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
        font-size: 1.15rem;
        font-style: italic;
        color: rgba(255, 255, 255, 0.5);
        letter-spacing: 0.03em;
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* ── Middle Section: Links Grid ── */
    .elite-footer__middle {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr 1.5fr;
        gap: 2rem;
        padding: 4rem 0;
        border-bottom: 1px solid rgba(198, 167, 94, 0.1);
    }

    .elite-footer__col-about {
        padding-right: 2rem;
    }

    .elite-footer__about-text {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
        line-height: 1.8;
        margin-bottom: 2rem;
    }

    .elite-footer__socials {
        display: flex;
        gap: 0.75rem;
    }

    .elite-footer__social-link {
        width: 42px;
        height: 42px;
        border: 1px solid rgba(198, 167, 94, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .elite-footer__social-link:hover {
        background: linear-gradient(135deg, #C6A75E, #F0D78C);
        border-color: #C6A75E;
        color: #0a0a0a;
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(198, 167, 94, 0.25);
    }

    /* Column Headers */
    .elite-footer__col-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #C6A75E;
        margin-bottom: 1.75rem;
        position: relative;
        padding-bottom: 0.75rem;
    }

    .elite-footer__col-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 24px;
        height: 1px;
        background: linear-gradient(90deg, #C6A75E, transparent);
    }

    .elite-footer__links {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .elite-footer__links li {
        margin-bottom: 0.875rem;
    }

    .elite-footer__links a {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.55);
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0;
        letter-spacing: 0.02em;
    }

    .elite-footer__links a::before {
        content: '';
        display: inline-block;
        width: 0;
        height: 1px;
        background: #C6A75E;
        margin-right: 0;
        transition: all 0.3s ease;
    }

    .elite-footer__links a:hover {
        color: #F0D78C;
    }

    .elite-footer__links a:hover::before {
        width: 16px;
        margin-right: 8px;
    }

    /* Contact Column */
    .elite-footer__contact-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.55);
    }

    .elite-footer__contact-item i {
        color: #C6A75E;
        font-size: 0.85rem;
        margin-top: 2px;
        width: 16px;
        text-align: center;
        flex-shrink: 0;
    }

    .elite-footer__contact-item a {
        color: rgba(255, 255, 255, 0.55);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .elite-footer__contact-item a:hover {
        color: #F0D78C;
    }

    /* Newsletter */
    .elite-footer__newsletter {
        margin-top: 1.5rem;
    }

    .elite-footer__newsletter-form {
        display: flex;
        border: 1px solid rgba(198, 167, 94, 0.2);
        overflow: hidden;
        transition: border-color 0.3s ease;
    }

    .elite-footer__newsletter-form:focus-within {
        border-color: rgba(198, 167, 94, 0.5);
    }

    .elite-footer__newsletter-input {
        flex: 1;
        background: rgba(255, 255, 255, 0.03);
        border: none;
        outline: none;
        padding: 0.875rem 1rem;
        color: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.02em;
    }

    .elite-footer__newsletter-input::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .elite-footer__newsletter-btn {
        background: linear-gradient(135deg, #C6A75E, #B8892D);
        border: none;
        padding: 0.875rem 1.25rem;
        color: #0a0a0a;
        cursor: pointer;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    .elite-footer__newsletter-btn:hover {
        background: linear-gradient(135deg, #F0D78C, #C6A75E);
    }

    /* ── Bottom Bar ── */
    .elite-footer__bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 3rem;
        max-width: 1280px;
        margin: 0 auto;
        flex-wrap: wrap;
        gap: 1rem;
        position: relative;
        z-index: 1;
    }

    .elite-footer__copyright {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.35);
        letter-spacing: 0.05em;
    }

    .elite-footer__legal {
        display: flex;
        gap: 2rem;
        align-items: center;
    }

    .elite-footer__legal a {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.35);
        text-decoration: none;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        transition: color 0.3s ease;
    }

    .elite-footer__legal a:hover {
        color: #C6A75E;
    }

    .elite-footer__legal-divider {
        width: 3px;
        height: 3px;
        background: rgba(198, 167, 94, 0.3);
        border-radius: 50%;
    }

    /* ── Responsive ── */
    @media (max-width: 1024px) {
        .elite-footer__middle {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .elite-footer__col-about {
            grid-column: 1 / -1;
            padding-right: 0;
            text-align: center;
        }

        .elite-footer__socials {
            justify-content: center;
        }

        .elite-footer__col-title::after {
            left: 50%;
            transform: translateX(-50%);
        }
    }

    @media (max-width: 768px) {
        .elite-footer__inner {
            padding: 4rem 1.5rem 0;
        }

        .elite-footer__middle {
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
        }

        .elite-footer__bottom {
            flex-direction: column;
            text-align: center;
            padding: 2rem 1.5rem;
        }

        .elite-footer__legal {
            justify-content: center;
        }
    }

    @media (max-width: 480px) {
        .elite-footer__middle {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .elite-footer__col-title::after {
            left: 50%;
            transform: translateX(-50%);
        }

        .elite-footer__socials {
            justify-content: center;
        }

        .elite-footer__newsletter-form {
            flex-direction: column;
        }

        .elite-footer__newsletter-btn {
            width: 100%;
        }
    }
</style>

